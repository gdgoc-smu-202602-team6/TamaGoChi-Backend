// game domain, all per user: daily goals by start date, study sessions, day settlements, the item catalog, owned
// items, rooms, likes and guestbooks.

/// One version of a user's daily goal. The version for a day is the latest start_on on or before it; none means the default goal (DailyGoal.default).
model UserDailyGoal {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startOn   DateTime @map("start_on") @db.Date
  /// contract: DailyGoal.minutes
  minutes   Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, startOn])
  @@map("user_daily_goals")
}

/// At most one running session per user (a partial unique index in prisma/sql/game.sql).
model UserStudySession {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz
  endedAt   DateTime? @map("ended_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, startedAt])
  @@map("user_study_sessions")
}

/// The highest level a user has reached. Levels come from XP, so a changed level table could lower one; this keeps
/// the level from going down (merged 6.4).
model UserLevel {
  userId    String   @id @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("user_levels")
}

/// The confirmed result of a past day. Today is computed, never stored.
model UserDaySettlement {
  userId             String   @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day                DateTime @db.Date
  studiedSeconds     Int      @map("studied_seconds")
  attended           Boolean
  goalMet            Boolean  @map("goal_met")
  hearts             Int
  bugs               Int
  bugProgressSeconds Int      @map("bug_progress_seconds")
  attendanceStreak   Int      @map("attendance_streak")
  absenceStreak      Int      @map("absence_streak")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, day])
  @@map("user_day_settlements")
}

/// The catalog, the same for every user. Seed data.
model Item {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code         String   @unique
  /// contract: Slot
  slot         String
  name         String
  /// contract: Grade
  grade        String
  price        Int
  minLevel     Int      @default(1) @map("min_level")
  defaultOwned Boolean  @default(false) @map("default_owned")
  /// False takes it out of the shop; who bought it keeps it (merged 8.3-6).
  onSale       Boolean  @default(true) @map("on_sale")
  /// The floor is room_size × room_size; only for the ROOM slot.
  roomSize     Int?     @map("room_size")
  /// The placement policy (openapi.yaml PlacementPolicy): all of surface_kind, width, height and solid, or none (not
  /// placed).
  /// contract: SurfaceKind
  surfaceKind  String?  @map("surface_kind")
  width        Int?
  height       Int?
  step         Float?
  solid        Boolean?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  owners   UserItem[]
  equipped UserRoomItem[]

  @@unique([id, slot])
  @@map("items")
}

/// An item a user bought. Default-owned items are owned without a row.
model UserItem {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String   @map("item_id") @db.Uuid
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  /// The price paid; stays when the catalog price changes.
  price     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, itemId])
  @@index([itemId])
  @@map("user_items")
}

/// A user's room. No row means the default room.
model UserRoom {
  userId             String    @id @map("user_id")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestbookCheckedAt DateTime? @map("guestbook_checked_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  items UserRoomItem[]

  @@map("user_rooms")
}

/// The item equipped in one slot of a room. The composite foreign key keeps the item's slot and the row's slot equal.
model UserRoomItem {
  userId    String   @map("user_id")
  room      UserRoom @relation(fields: [userId], references: [userId], onDelete: Cascade)
  /// contract: Slot
  slot      String
  itemId    String   @map("item_id") @db.Uuid
  item      Item     @relation(fields: [itemId, slot], references: [id, slot], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  placement UserRoomPlacement?

  @@id([userId, slot])
  @@index([itemId, slot])
  @@map("user_room_items")
}

/// Where the item equipped in a slot stands (openapi.yaml Placement).
model UserRoomPlacement {
  userId    String       @map("user_id")
  /// contract: Slot
  target    String
  /// Only an equipped item is placed (D-10): unequipping deletes its placement.
  equipped  UserRoomItem @relation(fields: [userId, target], references: [userId, slot], onDelete: Cascade)
  /// contract: Surface
  surface   String
  x         Float
  y         Float
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, target])
  @@map("user_room_placements")
}

model UserLike {
  /// The room's owner.
  userId      String   @map("user_id")
  user        User     @relation("LikedRoom", fields: [userId], references: [id], onDelete: Cascade)
  likerUserId String   @map("liker_user_id")
  liker       User     @relation("Liker", fields: [likerUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, likerUserId])
  @@index([likerUserId])
  @@map("user_likes")
}

/// Shown only within the club it was written in; the room's owner sees all of theirs.
model UserGuestbookEntry {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// The room's owner.
  userId       String   @map("user_id")
  user         User     @relation("GuestbookHost", fields: [userId], references: [id], onDelete: Cascade)
  clubId       String   @map("club_id") @db.Uuid
  club         Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  /// Null once the author has deleted their account.
  authorUserId String?  @map("author_user_id")
  author       User?    @relation("GuestbookAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  body         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, clubId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([clubId])
  @@index([authorUserId])
  @@map("user_guestbook_entries")
}
