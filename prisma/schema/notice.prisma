// notice area: notices and who read them.

model ClubNotice {
  id                String                         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  clubId            String                         @map("club_id") @db.Uuid
  club              Club                           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  categoryId        String                         @map("category_id") @db.Uuid
  category          ClubNoticeCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId     String?                        @map("subcategory_id") @db.Uuid
  subcategory       ClubNoticeCategorySubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  /// Null once the author has left: shown as a former member.
  authorMemberId    String?                        @map("author_member_id") @db.Uuid
  author            ClubMember?                    @relation(fields: [authorMemberId], references: [id], onDelete: SetNull)
  title             String
  body              String
  pinned            Boolean                        @default(false)
  notificationState String                         @map("notification_state")
  createdAt         DateTime                       @default(now()) @map("created_at") @db.Timestamptz

  reads ClubNoticeRead[]

  @@index([clubId, pinned(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([authorMemberId])
  @@map("club_notices")
}

model ClubNoticeRead {
  noticeId  String     @map("notice_id") @db.Uuid
  notice    ClubNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  memberId  String     @map("member_id") @db.Uuid
  member    ClubMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// When it was read.
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@id([noticeId, memberId])
  @@index([memberId])
  @@map("club_notice_reads")
}
