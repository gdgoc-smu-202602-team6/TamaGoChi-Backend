// club domain: clubs, their parts and notice categories, roles, applications, members, and notices and who read them.

model Club {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name       String
  /// contract: InviteCode
  inviteCode String   @unique @map("invite_code")
  revision   Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  parts            ClubPart[]
  noticeCategories ClubNoticeCategory[]
  members          ClubMember[]
  applications     ClubApplication[]
  notices          ClubNotice[]
  guestbookEntries UserGuestbookEntry[]

  @@map("clubs")
}

model ClubPart {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  clubId    String   @map("club_id") @db.Uuid
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  /// contract: PaletteColor
  color     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  members      ClubMember[]
  applications ClubApplication[]

  @@unique([clubId, name])
  @@map("club_parts")
}

model ClubNoticeCategory {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  clubId    String   @map("club_id") @db.Uuid
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  /// contract: PaletteColor
  color     String
  /// "전체공지". One per club, never deleted.
  preset    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  subcategories ClubNoticeCategorySubcategory[]
  notices       ClubNotice[]

  @@unique([clubId, name])
  @@map("club_notice_categories")
}

model ClubNoticeCategorySubcategory {
  id         String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  categoryId String             @map("category_id") @db.Uuid
  category   ClubNoticeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz

  notices ClubNotice[]

  @@unique([categoryId, name])
  @@map("club_notice_category_subcategories")
}

model ClubMember {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  clubId          String   @map("club_id") @db.Uuid
  club            Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  partId          String   @map("part_id") @db.Uuid
  part            ClubPart @relation(fields: [partId], references: [id], onDelete: Restrict)
  /// contract: MemberRole
  role            String
  notificationsOn Boolean  @default(true) @map("notifications_on")
  /// When the application was approved; the day of joining has no absence penalty (B-16).
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  noticeReads ClubNoticeRead[]

  @@unique([clubId, userId])
  @@index([userId])
  @@index([partId])
  @@map("club_members")
}

model ClubApplication {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  clubId    String    @map("club_id") @db.Uuid
  club      Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Null once the part was deleted; only a decided application can lose its part.
  partId    String?   @map("part_id") @db.Uuid
  part      ClubPart? @relation(fields: [partId], references: [id], onDelete: SetNull)
  /// contract: ApplicationState
  state     String    @default("PENDING")
  decidedAt DateTime? @map("decided_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@index([partId])
  @@index([clubId, state])
  @@map("club_applications")
}

model ClubNotice {
  id                String                         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  clubId            String                         @map("club_id") @db.Uuid
  club              Club                           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  categoryId        String                         @map("category_id") @db.Uuid
  category          ClubNoticeCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId     String?                        @map("subcategory_id") @db.Uuid
  subcategory       ClubNoticeCategorySubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  /// Null once the author has deleted their account; leaving the club keeps the author.
  authorUserId      String?                        @map("author_user_id")
  author            User?                          @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  title             String
  body              String
  pinned            Boolean                        @default(false)
  /// contract: NotificationState
  notificationState String                         @map("notification_state")
  createdAt         DateTime                       @default(now()) @map("created_at") @db.Timestamptz

  reads ClubNoticeRead[]

  @@index([clubId, pinned(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([authorUserId])
  @@map("club_notices")
}

model ClubNoticeRead {
  noticeId  String     @map("notice_id") @db.Uuid
  notice    ClubNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  memberId  String     @map("member_id") @db.Uuid
  member    ClubMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// When it was read.
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@id([noticeId, memberId])
  @@index([memberId])
  @@map("club_notice_reads")
}
