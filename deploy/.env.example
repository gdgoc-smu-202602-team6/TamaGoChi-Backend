# deploy/.env on the host (never committed). The app reads all of it; Caddy reads DOMAIN.
DOMAIN=api.tmgoc.kro.kr
# the certificate authorities write here when a certificate has a problem
ACME_EMAIL=
PORT=3000
# RDS, verified against the CA bundle in the image
DATABASE_URL=postgresql://USER:PASSWORD@RDS-ENDPOINT:5432/tamagochi?sslmode=verify-full&sslrootcert=/etc/ssl/rds/global-bundle.pem
# at least 32 characters; generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
PUBLIC_URL=https://api.tmgoc.kro.kr
# Browser origins (or patterns) that may call the API and sign in, comma-separated. localhost:* is the web app in
# development; add the web app's own origin when it is deployed.
TRUSTED_ORIGINS=http://localhost:*
# Account mail (verification, password reset) goes through SES from this sender; empty keeps it in the log.
MAIL_FROM=다마GoC치 <noreply@tmgoc.kro.kr>
# SES region. Credentials come from the EC2 instance role, never from this file.
AWS_REGION=ap-northeast-2
